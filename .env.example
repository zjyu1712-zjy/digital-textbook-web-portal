# 管理者在服务器填写。不要把真实 .env 发给使用者、提交到仓库或放进分享包。
PORTAL_DOMAIN=books.example.com
PORTAL_PUBLIC_ORIGIN=https://books.example.com
OPENAI_API_KEY=
# 填账号可用且支持视觉输入、Responses JSON mode 的模型 ID。
OPENAI_MODEL=
# 建议先设共享访问码控制试用范围；使用者无需注册账号。
PORTAL_ACCESS_CODE=
PORTAL_RETENTION_HOURS=24
PORTAL_MAX_FILES=10
PORTAL_MAX_FILE_BYTES=20971520
PORTAL_MAX_TOTAL_BYTES=62914560
PORTAL_MAX_PAGES=800
PORTAL_MAX_MODEL_CALLS=1200
PORTAL_MAX_QUEUE=4
PORTAL_MAX_STORED_JOBS=32
PORTAL_MAX_STORAGE_BYTES=2147483648
PORTAL_BROWSER_TIMEOUT=300

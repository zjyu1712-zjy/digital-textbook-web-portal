# 中国内地部署示例。复制为 .env，仅在自己的服务器填写，勿提交真实密钥。
PORTAL_DOMAIN=books.example.com
PORTAL_PUBLIC_ORIGIN=https://books.example.com
PORTAL_MODEL_PROVIDER=bailian
# 北京业务空间的模型 API Key 和业务空间 ID；不要使用 Coding Plan 的专用密钥。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# 支持图片和非思考 JSON mode；正式开放前必须进行真实小样本验收。
DASHSCOPE_MODEL=qwen3-vl-plus
# 初期应填写共享访问码，避免陌生人消耗模型费用。
PORTAL_ACCESS_CODE=
PORTAL_RETENTION_HOURS=24
PORTAL_MAX_FILES=10
PORTAL_MAX_FILE_BYTES=20971520
PORTAL_MAX_TOTAL_BYTES=62914560
PORTAL_MAX_PAGES=800
# 单任务请求次数上限（包括重试），不是人民币消费封顶。
# 达限会明确停止并保留检查点，不会缩写余下内容以冒充完整成品。
PORTAL_MAX_MODEL_CALLS=80
PORTAL_MAX_QUEUE=2
PORTAL_MAX_STORED_JOBS=16
PORTAL_MAX_STORAGE_BYTES=2147483648
PORTAL_BROWSER_TIMEOUT=300
